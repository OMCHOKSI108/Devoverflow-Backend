{
    "info": {
        "name": "DevOverflow AI Endpoints",
        "description": "Complete Postman collection for testing all AI endpoints in DevOverflow backend",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000/api/ai",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Get AI Status (Public)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/status",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "status"
                    ]
                }
            }
        },
        {
            "name": "2. Get Similar Questions (Public)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"questionTitle\": \"How to implement authentication in React?\",\n    \"questionBody\": \"I'm building a React app and need to add user authentication. What are the best practices for implementing login/logout functionality?\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/similar-questions",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "similar-questions"
                    ]
                }
            }
        },
        {
            "name": "3. Get Answer Suggestion (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"questionTitle\": \"How to connect MongoDB with Node.js?\",\n    \"questionBody\": \"I'm trying to connect my Node.js application to MongoDB. I have MongoDB installed locally. What are the steps to establish a connection and perform basic CRUD operations?\",\n    \"tags\": [\"nodejs\", \"mongodb\", \"database\"]\n}"
                },
                "url": {
                    "raw": "{{base_url}}/answer-suggestion",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "answer-suggestion"
                    ]
                }
            }
        },
        {
            "name": "4. Get Tag Suggestions (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"questionTitle\": \"React state not updating immediately\",\n    \"questionBody\": \"I'm having an issue where setState in React doesn't update the state immediately. The console.log shows the old value even after calling setState.\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/tag-suggestions",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "tag-suggestions"
                    ]
                }
            }
        },
        {
            "name": "5. AI Chatbot (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"message\": \"How do I reverse a string in JavaScript?\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/chatbot",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "chatbot"
                    ]
                }
            }
        },
        {
            "name": "6. Get Question Improvements (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"questionTitle\": \"help with code\",\n    \"questionBody\": \"my code not working pls fix\",\n    \"tags\": [\"javascript\"]\n}"
                },
                "url": {
                    "raw": "{{base_url}}/question-improvements",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "question-improvements"
                    ]
                }
            }
        },
        {
            "name": "7. Create Flowchart (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"prompt\": \"Create a flowchart for user authentication process\",\n    \"render\": true,\n    \"output\": \"png\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/flowchart",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "flowchart"
                    ]
                }
            }
        },
        {
            "name": "8. Get Flowchart Metadata (Protected)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/flowchart/:flow_id",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "flowchart",
                        ":flow_id"
                    ],
                    "variable": [
                        {
                            "key": "flow_id",
                            "value": "flow_a1b2c3d4e5f6",
                            "description": "Flowchart ID from creation response"
                        }
                    ]
                }
            }
        },
        {
            "name": "9. Get Flowchart Render Status (Protected)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/flowchart/:flow_id/render",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "flowchart",
                        ":flow_id",
                        "render"
                    ],
                    "variable": [
                        {
                            "key": "flow_id",
                            "value": "flow_a1b2c3d4e5f6",
                            "description": "Flowchart ID from creation response"
                        }
                    ]
                }
            }
        }
    ]
}